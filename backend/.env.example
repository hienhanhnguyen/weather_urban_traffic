# Copy to .env and fill in

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Match with docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_NAME=weather_traffic
DB_USER=postgres
DB_PASS=admin
DB_SSL=false

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_TTL_MINUTES=15

# Optional. Only the public client ID is needed
GOOGLE_CLIENT_ID=

# Open-Meteo. Free, keyless, no account: https://open-meteo.com
WEATHER_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_MS=15000
WEATHER_CACHE_CURRENT_TTL_MS=600000
WEATHER_CACHE_FORECAST_TTL_MS=3600000
MAX_SAVED_LOCATIONS=50
MAX_SAVED_ROUTES=50
SEARCH_DEDUPE_MINUTES=30

# Leave SMTP_HOST empty to log mail instead of sending it
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_SECURE=false

# Web push
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com


# Frontend dev server runs on 3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
WS_ALLOWED_ORIGINS=http://localhost:3001
WS_MAX_CONNECTIONS_PER_USER=5
WS_HEARTBEAT_MS=30000

ALERT_WORKER_ENABLED=true
ALERT_EVAL_INTERVAL_MINUTES=15
REPORT_WORKER_ENABLED=true
REPORT_INTERVAL_MINUTES=15
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_GRACE_DAYS=30
SHUTDOWN_TIMEOUT_MS=10000

GEOCODER_URL=https://photon.komoot.io
ROUTER_URL=https://routing.openstreetmap.de
GEO_USER_AGENT=SWTIS/1.0 (thesis project)
GEO_TIMEOUT_MS=8000
GEO_CACHE_SEARCH_TTL_MS=600000
GEO_CACHE_REVERSE_TTL_MS=86400000
GEO_CACHE_ROUTE_TTL_MS=600000
